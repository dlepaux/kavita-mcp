# kavita-mcp's environment for the made-up household in identities.yml. Every value is a placeholder.
KAVITA_URL=http://kavita:5000
KAVITA_MCP_IDENTITIES=/config/identities.yml
KAVITA_MCP_ADMIN_NAME=Bob

# One key per profile in identities.yml, and no other: a missing or an extra one stops the server.
# Each is that person's own Kavita API key, never an OPDS or an image-only key.
KAVITA_MCP_KEY_ALICE=replace-with-alices-kavita-api-key
KAVITA_MCP_KEY_BOB=replace-with-bobs-kavita-api-key
